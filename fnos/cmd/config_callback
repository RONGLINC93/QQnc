#!/bin/bash
# 安装后在「应用设置」修改端口时触发：保存新端口并重建容器
TRIM_APPDEST="${TRIM_APPDEST:-.}"
PORT_CONF="${TRIM_PKGETC:-${TRIM_PKGVAR}/etc}/qqfarm_port.conf"

P="${wizard_http_port:-}"
[ -z "$P" ] && [ -f "$PORT_CONF" ] && P="$(cat "$PORT_CONF" 2>/dev/null)"
case "$P" in ''|*[!0-9]*) P=8081 ;; esac
if [ "$P" -lt 1 ] || [ "$P" -gt 65535 ]; then P=8081; fi

mkdir -p "$(dirname "$PORT_CONF")" "${TRIM_APPDEST}/docker" 2>/dev/null
echo "$P" > "$PORT_CONF" 2>/dev/null
printf 'wizard_http_port=%s\n' "$P" > "${TRIM_APPDEST}/docker/.env" 2>/dev/null
export wizard_http_port="$P"
export QQFARM_HTTP_PORT="$P"

cd "${TRIM_APPDEST}/docker" || exit 0
# 只需重建 web（端口）与 panel（游戏链接），数据库容器保持运行
docker compose -p qqfarm -f docker-compose.yaml up -d --force-recreate web panel >/dev/null 2>&1 \
  || docker-compose -p qqfarm -f docker-compose.yaml up -d --force-recreate web panel >/dev/null 2>&1
exit 0
